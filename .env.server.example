# Mac mini central server. Copy to .env.server; never commit the filled file.
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
MYSQL_DATABASE=fb_commenter
MYSQL_USER=fbapp
MYSQL_PASSWORD=CHANGE_ME_APP
DB_PORT=3307
TZ=Asia/Ho_Chi_Minh
N8N_PORT=5678
N8N_ENCRYPTION_KEY=CHANGE_ME_N8N_KEY
AUTOMATION_TOKEN=CHANGE_ME_INTERNAL_TOKEN
DEVICE_ACTIVATION_CODE=CHANGE_ME_DEVICE_ACTIVATION
# Cloudflare Access is enforced at the edge. These values belong on Desktop clients, not this server.
DRY_RUN=true
LIVE_TEST_MAX_JOBS=1
API_INTERNAL_URL=http://api:4300
N8N_HEALTH_URL=http://n8n:5678/healthz
N8N_MANUAL_WEBHOOK_URL=http://n8n:5678/webhook/fb-comment-now
