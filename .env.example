MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=fb_commenter
MYSQL_USER=fbapp
MYSQL_PASSWORD=change_me_app
DB_HOST=127.0.0.1
DB_PORT=3307
TZ=Asia/Ho_Chi_Minh

API_PORT=4300
WEB_PORT=4173
N8N_PORT=5678
N8N_ENCRYPTION_KEY=replace_with_a_long_random_key

# Global safety switch. true = browser types but does not submit.
DRY_RUN=true
DRY_RUN_HOLD_MS=8000
# Giới hạn cứng: tối đa một job LIVE ở trạng thái RUNNING.
LIVE_TEST_MAX_JOBS=1
# API gọi workflow 02; workflow truyền lại URL nội bộ này cho Worker.
N8N_MANUAL_WEBHOOK_URL=http://127.0.0.1:5678/webhook/fb-comment-now
API_INTERNAL_URL=http://host.docker.internal:4300

# Dùng cùng một chuỗi dài, ngẫu nhiên cho API, n8n và trình điều khiển.
AUTOMATION_TOKEN=replace_with_a_long_random_token
# Runtime-only Cloudflare Access credentials for desktop development. Never commit real values.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
N8N_HEALTH_URL=http://127.0.0.1:5678/healthz
# Tên miền Cloudflare Tunnel, để trống nếu chỉ dùng localhost. Nhiều tên miền ngăn cách bằng dấu phẩy.
APP_ALLOWED_HOSTS=
