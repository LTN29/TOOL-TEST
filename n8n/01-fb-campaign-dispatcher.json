{
  "name": "01 FB Campaign Dispatcher",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "schedule-dispatch",
      "name": "Every 1 minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:4300/api/automation/claim-next",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "{}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-automation-token",
              "value": "={{ $env.AUTOMATION_TOKEN }}"
            }
          ]
        }
      },
      "id": "claim-next",
      "name": "Claim Next Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        230,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-run",
              "leftValue": "={{ $json.runId || '' }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-job",
      "name": "Has Job?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        470,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Claim Next Job').item.json.workerUrl + '/execute' }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ runId: $('Claim Next Job').item.json.runId, profileKey: $('Claim Next Job').item.json.profile_key, postUrl: $('Claim Next Job').item.json.post_url, commentText: $('Claim Next Job').item.json.comment_text, dryRun: $('Claim Next Job').item.json.dry_run }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-automation-token",
              "value": "={{ $env.AUTOMATION_TOKEN }}"
            }
          ]
        }
      },
      "id": "worker",
      "name": "Browser Worker",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        710,
        -70
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:4300/api/automation/jobs/{{$('Claim Next Job').item.json.runId}}/result",
        "options": {},
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ ok: !!$json.ok, errorCode: $json.errorCode || null, errorMessage: $json.error || null, skipped: false }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-automation-token",
              "value": "={{ $env.AUTOMATION_TOKEN }}"
            }
          ]
        }
      },
      "id": "save-result",
      "name": "Save Result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        950,
        -70
      ]
    }
  ],
  "connections": {
    "Every 1 minute": {
      "main": [
        [
          {
            "node": "Claim Next Job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim Next Job": {
      "main": [
        [
          {
            "node": "Has Job?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Job?": {
      "main": [
        [
          {
            "node": "Browser Worker",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Browser Worker": {
      "main": [
        [
          {
            "node": "Save Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
