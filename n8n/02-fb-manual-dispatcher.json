  "name": "02 FB Manual Dispatcher",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "fb-comment-now",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "manual-webhook",
      "name": "Manual Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "fb-comment-now"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:4300/api/automation/dispatch-job/{{$('Manual Webhook').item.json.body.jobId}}",
        "options": {},
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ idempotencyKey: $('Manual Webhook').item.json.body.idempotencyKey }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-automation-token",
              "value": "={{ $env.AUTOMATION_TOKEN }}"
            }
          ]
        }
      },
      "id": "claim-manual",
      "name": "Claim Manual Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        470,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Claim Manual Job').item.json.workerUrl + '/execute' }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ runId: $('Claim Manual Job').item.json.runId, profileKey: $('Claim Manual Job').item.json.profile_key, postUrl: $('Claim Manual Job').item.json.post_url, commentText: $('Claim Manual Job').item.json.comment_text, dryRun: $('Claim Manual Job').item.json.dry_run, idempotencyKey: $('Claim Manual Job').item.json.idempotency_key, progressUrl: $('Claim Manual Job').item.json.progressUrl, guardUrl: $('Claim Manual Job').item.json.guardUrl }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-automation-token",
              "value": "={{ $env.AUTOMATION_TOKEN }}"
            }
          ]
        }
      },
      "id": "manual-worker",
      "name": "Browser Worker",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        710,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://host.docker.internal:4300/api/automation/jobs/{{$('Claim Manual Job').item.json.runId}}/result",
        "options": {},
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ ok: !!$json.ok, outcome: $json.outcome || null, errorCode: $json.errorCode || null, errorMessage: $json.error || null, skipped: !!$json.dryRun, idempotencyKey: $('Claim Manual Job').item.json.idempotency_key }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-automation-token",
              "value": "={{ $env.AUTOMATION_TOKEN }}"
            }
          ]
        }
      },
      "id": "manual-save",
      "name": "Save Result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        950,
        0
      ]
    }
  ],
  "connections": {
    "Manual Webhook": {
      "main": [
        [
          {
            "node": "Claim Manual Job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim Manual Job": {
      "main": [
